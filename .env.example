# =============================================================================
# JeenLabs — environment variables
# Copy to .env (local dev) or set in your host (production).
# =============================================================================

NODE_ENV=development

# Listen port (default 3000 locally; override in production if needed)
PORT=3000

# -----------------------------------------------------------------------------
# Site URL (required for production)
# Used for: canonical URLs, sitemap.xml, robots.txt, Open Graph, JSON-LD
# Must match your live domain exactly (no trailing slash).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jeenlabs.com

# -----------------------------------------------------------------------------
# Google Analytics 4 (optional)
# Create at https://analytics.google.com → Admin → Data streams → Web
# Measurement ID format: G-XXXXXXXXXX
# Leave unset locally to disable tracking in dev.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Google Search Console (optional)
# Search Console → Settings → Ownership verification → HTML tag
# Paste only the content value, not the full meta tag.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code
