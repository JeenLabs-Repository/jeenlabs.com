# =============================================================================
# JeenLabs — environment variables
# Local: copy to .env.local
# Production: set in Coolify (see DEPLOYMENT.md)
# =============================================================================

NODE_ENV=development

# App listen port (Docker / Coolify image defaults to 3000)
PORT=3000

# -----------------------------------------------------------------------------
# Site URL (required in production)
# Canonical URLs, sitemap, robots, Open Graph, JSON-LD.
# No trailing slash. Must match the live domain.
# Coolify: available at BUILD time (Next.js inlines NEXT_PUBLIC_*).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jeenlabs.com

# -----------------------------------------------------------------------------
# Google Analytics 4 (optional) — BUILD time in Coolify
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Google Search Console (optional) — BUILD time in Coolify
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code
